{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Telemetry": {
    "Enabled": true,
    "OtlpEndpoint": ""
  },
  "SystemHealth": {
    "HeartbeatInterval": "00:00:10",
    "HeartbeatThreshold": "00:00:45",
    "QueryTimeout": "00:00:05",
    "BacklogWarningAfter": "00:05:00",
    "SeriesMinimumBuckets": 2
  }
}
