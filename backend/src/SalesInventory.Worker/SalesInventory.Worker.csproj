<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Comparte los User Secrets de la API (cadena de conexión) en desarrollo. -->
    <UserSecretsId>SalesInventory.Api-Development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SalesInventory.Application\SalesInventory.Application.csproj" />
    <ProjectReference Include="..\SalesInventory.Infrastructure\SalesInventory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
