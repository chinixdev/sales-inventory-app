{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 20,
    "LeaseDuration": "00:01:00",
    "HandlerTimeout": "00:00:30",
    "MaxAttempts": 5,
    "BaseRetryDelay": "00:00:05",
    "MaxRetryDelay": "00:05:00"
  },
  "Telemetry": {
    "Enabled": true,
    "OtlpEndpoint": ""
  },
  "SystemHealth": {
    "HeartbeatInterval": "00:00:10",
    "HeartbeatThreshold": "00:00:45",
    "QueryTimeout": "00:00:05",
    "BacklogWarningAfter": "00:05:00",
    "SeriesMinimumBuckets": 2
  }
}
