{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/sales-inventory-app/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REEMPLAZA-CON-LA-URL-DE-TU-API/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
